# ===== Local development mode =====
MOCK=1                       # Local demo only; set 0 only after configuring a real provider.
MOCK_FALLBACK=1              # Local fallback if every configured provider fails.

# ===== Database (Turso Cloud — needed for Vercel) =====
TURSO_DATABASE_URL=          # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=            # your Turso auth token
SQLITE_PATH=corp.db          # local fallback when Turso is not set

# ===== Free LLM providers (any subset). Several keys per provider: key1,key2 =====
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=              # optional; disabled in practice if it does not work for you
# Model names change often - copy exact ids from each provider's dashboard
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free
# Any other OpenAI-compatible provider, unlimited count:
# EXTRA_PROVIDERS=name|https://host/v1/chat/completions|key1,key2|model|vision_model;name2|...
# Order override per tier: ORDER_BRAIN=nvidia,mistral  ORDER_WORKER=groq,cerebras  ORDER_VISION=nvidia,mistral

# Wesam.ai (only if you find an OpenAI-compatible endpoint in their dashboard/docs)
WESAM_API_URL=
WESAM_API_KEY=
WESAM_MODEL=default

# ===== Telegram (owner approvals + client chat + photos) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ===== Tools =====
TAVILY_API_KEY=              # optional, better web_search (free tier); else DuckDuckGo fallback
FIGMA_TOKEN=                 # optional, read-only Figma access
NETLIFY_TOKEN=               # controlled test publishing only; requires ENABLE_AUTOMATED_DEPLOYMENT=1
OUTBOUND_WEBHOOKS=           # named public HTTPS endpoints: job_delivered=https://hook...

# ===== Security (set ALL of these before exposing publicly) =====
# Use long, distinct random values managed by your deployment secret store.
AUTH_SECRET_KEY=             # signs browser session tokens
ADMIN_PASSWORD=              # administrator login; never expose as a token
PUBLIC_URL=                  # canonical https://app.example.com origin
TRUSTED_ORIGINS=             # optional comma-separated first-party origins
MAINTENANCE_MODE=0           # set to 1 during incident response; rejects all writes
BACKUP_ENCRYPTION_KEY=       # URL-safe base64 32-byte AES-256 key; local backup tool only
HOOK_KEY=                    # inbound /api/hooks/job
CRON_KEY=                    # /api/tick
TELEGRAM_SECRET=             # validates Telegram webhook delivery
OUTBOUND_WEBHOOK_SECRET=     # distinct HMAC key used to sign outbound events

# High-risk prototype features are disabled by default. Do not enable them
# until their secure replacements described in the remediation plan are ready.
ENABLE_DIRECT_DEPLOYMENT=0
ENABLE_AUTOMATED_DEPLOYMENT=0  # Netlify publishing requires explicit approval
ENABLE_TENANT_FILE_EDITOR=0
ENABLE_TENANT_SQL_CONSOLE=0
ENABLE_TENANT_BOT_CREDENTIALS=0
ENABLE_DEMO_PAYMENT_ACTIVATION=0
ENABLE_OUTBOUND_WEBHOOKS=0   # requires public HTTPS endpoints and signing secret

# ===== Autonomy =====
PLAN_APPROVAL_THRESHOLD_EGP=2000
SALARY_EGP_PER_1K_TOKENS=0.8
TICK_SECONDS=0               # >0 = internal self-improvement loop every N seconds
AUTONOMOUS_MARKETING=0       # 1 = drafts a promo post daily (still needs your approval)
AUTO_APPROVE=0               # allow high-cost plans/new roles only after owner approval
AUTO_DELIVER=0               # delivery, customer notices, and webhooks require owner approval
