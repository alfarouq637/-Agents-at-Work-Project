# ===== Mode =====
MOCK=1                       # 1 = no API needed (demo). Set 0 when you add keys.
MOCK_FALLBACK=1              # 1 = use mock output if all providers fail

# ===== Database (Turso Cloud — needed for Vercel) =====
TURSO_DATABASE_URL=          # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=            # your Turso auth token
SQLITE_PATH=corp.db          # local fallback when Turso is not set

# ===== Free LLM providers (any subset). Several keys per provider: key1,key2 =====
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=              # optional; disabled in practice if it does not work for you
# Model names change often - copy exact ids from each provider's dashboard
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free
# Any other OpenAI-compatible provider, unlimited count:
# EXTRA_PROVIDERS=name|https://host/v1/chat/completions|key1,key2|model|vision_model;name2|...
# Order override per tier: ORDER_BRAIN=nvidia,mistral  ORDER_WORKER=groq,cerebras  ORDER_VISION=nvidia,mistral

# Wesam.ai (only if you find an OpenAI-compatible endpoint in their dashboard/docs)
WESAM_API_URL=
WESAM_API_KEY=
WESAM_MODEL=default

# ===== Telegram (owner approvals + client chat + photos) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_SECRET=             # any random string
PUBLIC_URL=                  # https://your-app.example.com  (then POST /api/telegram/setup)

# ===== Tools =====
TAVILY_API_KEY=              # optional, better web_search (free tier); else DuckDuckGo fallback
FIGMA_TOKEN=                 # optional, read-only Figma access
NETLIFY_TOKEN=               # optional, real deployment of generated sites
OUTBOUND_WEBHOOKS=           # job_delivered=https://hook...;post_approved=https://hook...  (Make/n8n/Zapier)

# ===== Security (set ALL of these before exposing publicly) =====
ADMIN_KEY=                   # dashboard + approvals
HOOK_KEY=                    # inbound /api/hooks/job
CRON_KEY=                    # /api/tick

# ===== Autonomy =====
PLAN_APPROVAL_THRESHOLD_EGP=2000
SALARY_EGP_PER_1K_TOKENS=0.8
TICK_SECONDS=0               # >0 = internal self-improvement loop every N seconds
AUTONOMOUS_MARKETING=0       # 1 = drafts a promo post daily (still needs your approval)
