{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "static/**",
          "api/static/**",
          "bot_avatar.jpg"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/telegram",
      "dest": "api/index.py"
    },
    {
      "src": "/sites/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/bot_avatar.jpg",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
